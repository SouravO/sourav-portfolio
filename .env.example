# Server-only. Never prefix secrets with VITE_. Copy to .env.local.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a long random secret; changing it resets per-visitor quota identities.
RATE_LIMIT_SECRET=
AI_HOURLY_LIMIT=5
AI_DAILY_LIMIT=100
# Exact production origin, e.g. https://your-domain.example (no trailing slash)
ALLOWED_ORIGIN=
